# Anthropic API — server-side only, never exposed to the browser
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Embeddings (optional). Without a key the retriever falls back to BM25 only.
VOYAGE_API_KEY=

# Which document corpus to load: "parcelpilot" (assessment pack) | "synthetic"
CORPUS=parcelpilot

# Paths
DATA_DIR=data
INDEX_DIR=data/index

# Abuse control on the public demo
MAX_MESSAGES_PER_SESSION=25
MAX_AGENT_STEPS=12
