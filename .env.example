# Model provider -- server-side only, never exposed to the browser.
# Any provider speaking the OpenAI chat-completions API works: OpenAI itself,
# Gemini via its compatibility endpoint, OpenRouter, Together. Swapping is a key,
# a model name and a base URL. Defaults below are Gemini, which has a free tier.
MODEL_API_KEY=
MODEL_NAME=gemini-3.7-flash
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# For OpenAI instead, leave MODEL_BASE_URL empty and set MODEL_NAME to a model
# your key can reach -- `python -m parcelpilot.cli models` lists them.

# Answer without calling any provider. A real mode, not a test switch.
SCRIPTED=0

CORPUS=parcelpilot

# Paths
DATA_DIR=data
INDEX_DIR=data/index

# Abuse control on the public demo
MAX_MESSAGES_PER_SESSION=25
MAX_AGENT_STEPS=12
