# OpenAI API — server-side only, never exposed to the browser.
# Confirm the model id against your own console; it must support tool calling.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5

# Which document corpus to load: "parcelpilot" (assessment pack) | "synthetic"
CORPUS=parcelpilot

# Paths
DATA_DIR=data
INDEX_DIR=data/index

# Abuse control on the public demo
MAX_MESSAGES_PER_SESSION=25
MAX_AGENT_STEPS=12
